# Customer case data (local-only, never push — contains customer data)
cases/*/
!cases/README.md
!cases/_index.md
!cases/_template/
!cases/_template/**

# Agent work directories (per-investigation artefacts)
.agent_work/

# Memory bank (per-developer local context)
memory-bank/

# Shared memory — org-specific knowledge (repo names, bug IDs, customer case patterns)
# These grow from real work and must NOT be exposed externally.
# Share them via your internal Bitbucket repo, not GitHub.
shared/memory/*
!shared/memory/templates/
!shared/memory/templates/**
!shared/memory/README.md

# Centralization script logs
shared/memory/logs/

# Org-specific sprint/feature plans — contain internal project codes and ticket numbers
shared/plans/*.md
!shared/plans/README.md

# Repo catalogue — lists all internal Bitbucket repo names and their purposes
shared/skills/remote-repo-exploration/references/repo-categories.md

# Per-developer personal instructions
personal-instructions.md

# Generated by bin/setup-local.ps1 — local org context, never push
.local.env
shared/instructions/copilot-local.instructions.md

# OS files
Thumbs.db
.DS_Store
*.swp
*~

# IDE
.idea/
.vscode/
*.iml
